# Copy to .dev.vars for local Worker development. Never commit real values.
GOOGLE_CLIENT_ID="replace-me.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-me"
# OAuth must use localhost; Google rejects private-IP callbacks such as 10.x.x.x.
OAUTH_REDIRECT_ORIGIN="http://localhost:5173"
VAPID_PUBLIC_KEY="replace-me"
VAPID_PRIVATE_KEY="replace-me"
VAPID_SUBJECT="mailto:you@example.com"
